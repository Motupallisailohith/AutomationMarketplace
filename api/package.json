{
  "name": "@automation-platform/api",
  "version": "1.0.0",
  "description": "API Gateway and Service Layer for Automation Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:demo": "tsx src/demo-server.ts",
    "dev:n8n": "node node_modules/n8n/bin/n8n start --env-file=../.env.n8n",
    "dev:simple": "tsx watch --require ./module-alias.js src/server-simple.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:simple": "tsx --require ./module-alias.js src/server-simple.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "@n8n/backend-common": "workspace:*",
    "@n8n/config": "workspace:*",
    "@n8n/db": "workspace:*",
    "@n8n/decorators": "workspace:*",
    "@n8n/di": "workspace:*",
    "@temporalio/client": "^1.8.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.9.0",
    "express-validator": "^7.0.1",
    "fast-glob": "^3.3.3",
    "helmet": "^7.0.0",
    "jaeger-client": "^3.19.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "n8n": "^2.7.5",
    "n8n-core": "^2.7.2",
    "n8n-nodes-base": "^2.7.2",
    "n8n-workflow": "^2.8.0",
    "nodemailer": "catalog:",
    "opentracing": "^0.14.7",
    "pg": "^8.11.3",
    "prom-client": "^14.2.0",
    "redis": "^4.6.8",
    "reflect-metadata": "*",
    "sqlite3": "catalog:",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.0",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.10.2",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
