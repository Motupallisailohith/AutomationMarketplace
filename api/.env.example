DB_HOST=localhost
DB_PORT=5432
DB_NAME=automation_platform
DB_USER=postgres
DB_PASSWORD=password
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-change-in-production
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TEMPORAL_HOST=localhost:7233

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (for password reset emails)
# INSTRUCTIONS FOR SETUP:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the values below with your actual email credentials
# 3. For Gmail: Get App Password from https://support.google.com/accounts/answer/185833
# 4. Restart the API server after updating .env
# 
# NOTE: If you leave SMTP_USER and SMTP_PASS empty, password reset links will be logged to console only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Example SMTP configurations:
# Gmail: host=smtp.gmail.com, port=587 (use app password)
# Outlook: host=smtp-mail.outlook.com, port=587
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey
# Mailgun: host=smtp.mailgun.org, port=587
