/**
 * Credentials Controller - Manages workflow credentials
 * Based on n8n's credentials.controller.ts
 */

import { Router, Request, Response } from 'express';
import { v4 as uuid } from 'uuid';
import * as crypto from 'crypto';

// Types
interface Credential {
    id: string;
    name: string;
    type: string;
    data: Record<string, any>;
    createdAt: Date;
    updatedAt: Date;
}

export class CredentialsController {
    private router: Router;
    private encryptionKey: string;

    constructor() {
        this.router = Router();
        this.encryptionKey = process.env.ENCRYPTION_KEY || 'default-encryption-key-change-in-production';
        this.setupRoutes();
    }

    private setupRoutes() {
        // GET /credentials - List all credentials
        this.router.get('/', this.getAllCredentials.bind(this));

        // GET /credentials/:id - Get single credential
        this.router.get('/:id', this.getCredential.bind(this));

        // POST /credentials - Create new credential
        this.router.post('/', this.createCredential.bind(this));

        // PUT /credentials/:id - Update credential
        this.router.put('/:id', this.updateCredential.bind(this));

        // DELETE /credentials/:id - Delete credential
        this.router.delete('/:id', this.deleteCredential.bind(this));

        // GET /credentials/types - Get available credential types
        this.router.get('/types/all', this.getCredentialTypes.bind(this));

        // POST /credentials/:id/test - Test credential
        this.router.post('/:id/test', this.testCredential.bind(this));
    }

    /**
     * Encrypt credential data
     */
    private encrypt(data: string): string {
        const algorithm = 'aes-256-cbc';
        const key = crypto.scryptSync(this.encryptionKey, 'salt', 32);
        const iv = crypto.randomBytes(16);

        const cipher = crypto.createCipheriv(algorithm, key, iv);
        let encrypted = cipher.update(data, 'utf8', 'hex');
        encrypted += cipher.final('hex');

        return `${iv.toString('hex')}:${encrypted}`;
    }

    /**
     * Decrypt credential data
     */
    private decrypt(encrypted: string): string {
        const algorithm = 'aes-256-cbc';
        const key = crypto.scryptSync(this.encryptionKey, 'salt', 32);

        const [ivHex, encryptedData] = encrypted.split(':');
        const iv = Buffer.from(ivHex, 'hex');

        const decipher = crypto.createDecipheriv(algorithm, key, iv);
        let decrypted = decipher.update(encryptedData, 'hex', 'utf8');
        decrypted += decipher.final('utf8');

        return decrypted;
    }

    /**
     * GET /credentials
     */
    private async getAllCredentials(req: Request, res: Response) {
        try {
            // TODO: Fetch from database
            const credentials: Credential[] = [];

            // Don't return sensitive data
            const sanitized = credentials.map(cred => ({
                id: cred.id,
                name: cred.name,
                type: cred.type,
                createdAt: cred.createdAt,
                updatedAt: cred.updatedAt,
            }));

            res.json({
                data: sanitized,
                count: sanitized.length,
            });
        } catch (error) {
            console.error('Error getting credentials:', error);
            res.status(500).json({ error: 'Internal server error' });
        }
    }

    /**
     * GET /credentials/:id
     */
    private async getCredential(req: Request, res: Response) {
        try {
            const { id } = req.params;

            // TODO: Fetch from database
            const credential = null;

            if (!credential) {
                return res.status(404).json({ error: 'Credential not found' });
            }

            res.json(credential);
        } catch (error) {
            console.error('Error getting credential:', error);
            res.status(500).json({ error: 'Internal server error' });
        }
    }

    /**
     * POST /credentials
     */
    private async createCredential(req: Request, res: Response) {
        try {
            const { name, type, data } = req.body;

            // Encrypt sensitive data
            const encryptedData = this.encrypt(JSON.stringify(data));

            const newCredential: Credential = {
                id: uuid(),
                name,
                type,
                data: { encrypted: encryptedData },
                createdAt: new Date(),
                updatedAt: new Date(),
            };

            // TODO: Save to database

            console.log('✅ Created credential:', newCredential.id);

            res.status(201).json({
                id: newCredential.id,
                name: newCredential.name,
                type: newCredential.type,
            });
        } catch (error) {
            console.error('Error creating credential:', error);
            res.status(500).json({ error: 'Internal server error' });
        }
    }

    /**
     * PUT /credentials/:id
     */
    private async updateCredential(req: Request, res: Response) {
        try {
            const { id } = req.params;
            const { name, data } = req.body;

            // Encrypt new data if provided
            let encryptedData;
            if (data) {
                encryptedData = this.encrypt(JSON.stringify(data));
            }

            // TODO: Update in database

            console.log('✅ Updated credential:', id);

            res.json({ id, name });
        } catch (error) {
            console.error('Error updating credential:', error);
            res.status(500).json({ error: 'Internal server error' });
        }
    }

    /**
     * DELETE /credentials/:id
     */
    private async deleteCredential(req: Request, res: Response) {
        try {
            const { id } = req.params;

            // TODO: Delete from database
            // TODO: Check if credential is in use

            console.log('✅ Deleted credential:', id);

            res.status(204).send();
        } catch (error) {
            console.error('Error deleting credential:', error);
            res.status(500).json({ error: 'Internal server error' });
        }
    }

    /**
     * GET /credentials/types/all
     */
    private async getCredentialTypes(req: Request, res: Response) {
        try {
            // TODO: Load from nodes-base/credentials
            const credentialTypes = [
                {
                    name: 'slackOAuth2Api',
                    displayName: 'Slack OAuth2 API',
                    properties: [],
                },
                {
                    name: 'googleOAuth2Api',
                    displayName: 'Google OAuth2 API',
                    properties: [],
                },
                // ... 300+ more
            ];

            res.json(credentialTypes);
        } catch (error) {
            console.error('Error getting credential types:', error);
            res.status(500).json({ error: 'Internal server error' });
        }
    }

    /**
     * POST /credentials/:id/test
     */
    private async testCredential(req: Request, res: Response) {
        try {
            const { id } = req.params;

            // TODO: Test credential by making sample API call

            res.json({ success: true, message: 'Credential is valid' });
        } catch (error) {
            console.error('Error testing credential:', error);
            res.status(400).json({ error: 'Credential test failed' });
        }
    }

    public getRouter(): Router {
        return this.router;
    }
}
