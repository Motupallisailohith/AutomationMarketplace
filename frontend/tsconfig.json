{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@app/*": ["./src/app/*"],
      "@features/*": ["./src/features/*"],
      "@types/*": ["./src/types/*"],
      "@api/*": ["./src/api/*"],
      "@store/*": ["./src/store/*"]
    },

    "types": ["vite/client", "node"]
  },
  "files": [
    "src/main.tsx",
    "src/App.tsx",
    "src/pages/Login.tsx",
    "src/components/Canvas/WorkflowCanvas.tsx",
    "src/components/Canvas/WorkflowNode.tsx",
    "src/components/Canvas/NodeLibrary.tsx",
    "src/components/Layout/WorkflowHeader.tsx",
    "src/demo/researchProposalDemo.ts",
    "src/api/client.ts",
    "src/app/stores/index.ts",
    "src/app/stores/hooks.ts",
    "src/app/stores/userStore.ts",
    "src/app/stores/slices/authSlice.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
