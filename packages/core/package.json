{
  "name": "n8n-core",
  "version": "2.2.0",
  "description": "Core functionality of n8n",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "bin": {
    "n8n-copy-static-files": "./bin/copy-static-files",
    "n8n-generate-translations": "./bin/generate-translations",
    "n8n-generate-metadata": "./bin/generate-metadata"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "pnpm watch",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "watch": "tsc-watch -p tsconfig.build.json --onCompilationComplete \"tsc-alias -p tsconfig.build.json\"",
    "test": "jest",
    "test:unit": "jest",
    "test:dev": "jest --watch"
  },
  "files": [
    "dist",
    "bin"
  ],
  "devDependencies": {
    "@n8n/errors": "workspace:*",
    "@n8n/typescript-config": "workspace:*",
    "@types/express": "*",
    "@types/jsonwebtoken": "*",
    "@types/lodash": "*",
    "@types/mime-types": "*",
    "@types/proxy-from-env": "^1.0.4",
    "@types/uuid": "*",
    "@types/xml2js": "*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.808.0",
    "@langchain/core": "*",
    "@n8n/backend-common": "workspace:*",
    "@n8n/client-oauth2": "workspace:*",
    "@n8n/config": "workspace:*",
    "@n8n/constants": "workspace:*",
    "@n8n/decorators": "workspace:*",
    "@n8n/di": "workspace:*",
    "@sentry/node": "*",
    "@sentry/node-native": "^9.42.1",
    "axios": "*",
    "callsites": "*",
    "chardet": "2.0.0",
    "cron": "3.1.7",
    "fast-glob": "*",
    "file-type": "16.5.4",
    "form-data": "*",
    "htmlparser2": "^10.0.0",
    "http-proxy-agent": "*",
    "https-proxy-agent": "*",
    "iconv-lite": "*",
    "jsonwebtoken": "*",
    "lodash": "*",
    "luxon": "*",
    "mime-types": "*",
    "n8n-workflow": "workspace:*",
    "nanoid": "*",
    "oauth-1.0a": "2.2.6",
    "p-cancelable": "2.1.1",
    "picocolors": "*",
    "pretty-bytes": "5.6.0",
    "proxy-from-env": "^1.1.0",
    "qs": "6.11.0",
    "ssh2": "1.15.0",
    "uuid": "*",
    "winston": "3.14.2",
    "xml2js": "*",
    "zod": "*"
  }
}